+static void *sps_keyed_archive(const char *gid, uint32_t *len) {
+  plist_t root = plist_new_dict();
+  plist_dict_set_item(root, "$version", plist_new_uint(100000));
+  plist_dict_set_item(root, "$archiver", plist_new_string("NSKeyedArchiver"));
+  plist_t top = plist_new_dict();
+  plist_dict_set_item(top, "root", plist_new_uid(1));
+  plist_dict_set_item(root, "$top", top);
+  plist_t objs = plist_new_array();
+  plist_array_append_item(objs, plist_new_string("$null"));
+  plist_t o1 = plist_new_dict();
+  plist_t nso = plist_new_array();
+  plist_array_append_item(nso, plist_new_uid(2));
+  plist_dict_set_item(o1, "NS.objects", nso);
+  plist_dict_set_item(o1, "$class", plist_new_uid(3));
+  plist_array_append_item(objs, o1);
+  plist_array_append_item(objs, plist_new_string(gid));
+  plist_t o3 = plist_new_dict();
+  plist_dict_set_item(o3, "$classname", plist_new_string("NSMutableArray"));
+  plist_t cls = plist_new_array();
+  plist_array_append_item(cls, plist_new_string("NSMutableArray"));
+  plist_array_append_item(cls, plist_new_string("NSArray"));
+  plist_array_append_item(cls, plist_new_string("NSObject"));
+  plist_dict_set_item(o3, "$classes", cls);
+  plist_array_append_item(objs, o3);
+  plist_dict_set_item(root, "$objects", objs);
+  char *bin = NULL;
+  plist_to_bin(root, &bin, len);
+  plist_free(root);
+  return bin;
+}
+
+// the receiver controls the phone through the event channel ("POST /command", MediaRemote command)
+static int sps_send_event_request(int fd, struct pair_cipher_context *cc, const uint8_t *msg, size_t len) {
+  uint8_t *enc = NULL;
+  size_t enc_len = 0;
+  if (pair_encrypt(&enc, &enc_len, msg, len, cc) < 0)
+    return -1;
+  int r = (send(fd, enc, enc_len, MSG_NOSIGNAL) == (ssize_t)enc_len) ? 0 : -1;
+  free(enc);
+  return r;
+}
+
+static int sps_send_command(rtsp_conn_info *conn, int fd, struct pair_cipher_context *cc, const char *name,
+                            int *cseq) {
+  static const struct { const char *name; const char *mr; } cmds[] = {
+      {"play", "0"}, {"pause", "1"}, {"playpause", "2"}, {"next", "4"}, {"previous", "5"}};
+  const char *mr = NULL;
+  for (unsigned i = 0; i < sizeof(cmds) / sizeof(cmds[0]); i++)
+    if (strcmp(name, cmds[i].name) == 0)
+      mr = cmds[i].mr;
+  if (!mr)
+    return -1;
+  const char *gid = conn->airplay_gid ? conn->airplay_gid : config.airplay_pi;
+  uint32_t alen = 0;
+  char *archive = sps_keyed_archive(gid, &alen);
+  uuid_t u;
+  char us[40];
+  uuid_generate_random(u);
+  uuid_unparse_upper(u, us);
+
+  plist_t params = plist_new_dict();
+  plist_dict_set_item(params, "kMRMediaRemoteOptionSendOptionsNumber", plist_new_uint(0));
+  plist_dict_set_item(params, "kMRMediaRemoteOptionCommandID", plist_new_string(us));
+  plist_dict_set_item(params, "kMRMediaRemoteOptionIsRedirectingCommand", plist_new_bool(1));
+  plist_dict_set_item(params, "kMRMediaRemoteOptionDestinationDeviceUIDs", plist_new_data(archive, alen));
+  plist_t top = plist_new_dict();
+  plist_dict_set_item(top, "modernMediaRemoteCommand", plist_new_string(mr));
+  plist_dict_set_item(top, "type", plist_new_string("sendMediaRemoteCommand"));
+  plist_dict_set_item(top, "params", params);
+  char *body = NULL;
+  uint32_t blen = 0;
+  plist_to_bin(top, &body, &blen);
+  plist_free(top);
+  free(archive);
+
+  *cseq = (*cseq >= 99) ? 10 : *cseq + 1;
+  char head[200];
+  int hl = snprintf(head, sizeof(head),
+                    "POST /command RTSP/1.0\r\nContent-Length: %u\r\n"
+                    "Content-Type: application/x-apple-binary-plist\r\nCSeq: %d\r\n\r\n",
+                    blen, *cseq);
+  uint8_t *msg = malloc(hl + blen);
+  memcpy(msg, head, hl);
+  memcpy(msg + hl, body, blen);
+  free(body);
+  int r = sps_send_event_request(fd, cc, msg, hl + blen);
+  free(msg);
+  debug(1, "Connection %d: event channel command \"%s\" (MR %s, group \"%s\") sent: %d",
+        conn->connection_number, name, mr, gid, r);
+  return r;
+}
